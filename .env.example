# ==============================================================================
# ZENTARA REALTY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Rename this file to .env.local for local development or configure these variables
# directly in your hosting platform (Vercel, Netlify, Railway, AWS, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL & SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://zentararealty.property

# ------------------------------------------------------------------------------
# 2. GOOGLE ANALYTICS 4 (GA4)
# ------------------------------------------------------------------------------
# Add your GA4 Measurement ID below (format: G-XXXXXXXXXX).
# Privacy notice: GA4 tracking scripts will only initialize after explicit user
# consent via the website's Cookie Consent banner (Analytics Cookies).
# Leave blank or unconfigured to disable analytics tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 3. GOOGLE SEARCH CONSOLE (GSC) VERIFICATION
# ------------------------------------------------------------------------------
# Add your Google Search Console HTML meta-tag verification token string here.
# (e.g., "google-site-verification-code-from-search-console")
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=

# ------------------------------------------------------------------------------
# 4. ENQUIRY FORM DISPATCH (OPTIONAL BACKEND INTEGRATIONS)
# ------------------------------------------------------------------------------
# Optional webhook endpoint (e.g., Slack webhook, Zapier, Make, CRM webhook)
# to receive incoming validated residential enquiries.
ENQUIRY_WEBHOOK_URL=

# Optional administrative email to receive lead notifications
ENQUIRY_NOTIFICATION_EMAIL=zentararealty@gmail.com
