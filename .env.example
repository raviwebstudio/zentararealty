# ==============================================================================
# ZENTARA REALTY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Rename this file to .env.local for local development or configure these variables
# directly in your hosting platform (Vercel, Netlify, Railway, AWS, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL & SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://zentararealty.property

# ------------------------------------------------------------------------------
# 2. CONTACT FORM EMAIL NOTIFICATIONS (MANDATORY FOR EMAIL DELIVERY)
# ------------------------------------------------------------------------------
# Every submitted website enquiry is sent to zentararealty@gmail.com.
# You can choose EITHER Option A (Resend API) OR Option B (Gmail App Password / SMTP).

# Primary notification recipient (Default: zentararealty@gmail.com)
NOTIFICATION_EMAIL_TO=zentararealty@gmail.com

# --- OPTION A: RESEND (Recommended for Vercel / Cloud serverless) ---
# Sign up at https://resend.com, generate an API key, and configure:
RESEND_API_KEY=
# Sender email (requires verified domain on Resend, or use "onboarding@resend.dev" for testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- OPTION B: GMAIL APP PASSWORD (Direct SMTP with zero external services) ---
# Steps to generate a Gmail App Password:
# 1. Open Google Account (zentararealty@gmail.com) -> Security
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Search "App Passwords" or navigate to https://myaccount.google.com/apppasswords
# 4. Create an app named "Zentara Realty Website"
# 5. Copy the 16-character password into SMTP_PASS below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zentararealty@gmail.com
SMTP_PASS=

# ------------------------------------------------------------------------------
# 3. GOOGLE ANALYTICS 4 (GA4)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DZPGFHCJNJ

# ------------------------------------------------------------------------------
# 4. GOOGLE SEARCH CONSOLE (GSC) VERIFICATION
# ------------------------------------------------------------------------------
# Add your Google Search Console HTML meta-tag verification token string here.
# (e.g., "google-site-verification-code-from-search-console")
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=

# ------------------------------------------------------------------------------
# 5. OPTIONAL WEBHOOK / CRM FORWARDING
# ------------------------------------------------------------------------------
# Optional webhook endpoint (e.g., Slack webhook, Zapier, Make, CRM webhook)
# to receive secondary dispatch of incoming validated residential enquiries.
ENQUIRY_WEBHOOK_URL=
